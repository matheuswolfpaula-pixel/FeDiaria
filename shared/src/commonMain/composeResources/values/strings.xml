  <!-- Ajuda: lembretes -->
  <string name="ajuda_intro">Alguns celulares economizam bateria fechando apps em segundo plano, e isso pode atrasar ou bloquear os lembretes. Veja o que ajuda:</string>
  <string name="ajuda_passo_notificacoes">1. Confira se as notificações do FéDiária estão ligadas.</string>
  <string name="ajuda_passo_bateria">2. Deixe o FéDiária sem restrição de bateria (“Sem restrições” ou “Não otimizar”).</string>
  <string name="ajuda_passo_fabricante">3. Ajustes do seu aparelho:</string>
  <string name="ajuda_atraso">Os lembretes podem chegar alguns minutos depois do horário: o Android agrupa avisos para poupar bateria. Se o celular estiver parado e com a tela apagada há muito tempo, o aviso aparece assim que você o pegar.</string>
  <string name="ajuda_fabricante_samsung">Samsung: Configurações › Bateria › Limites de uso em segundo plano. Tire o FéDiária de “Apps em suspensão” e “Apps em suspensão profunda”.</string>
  <string name="ajuda_fabricante_xiaomi">Xiaomi, Redmi e POCO: Configurações › Apps › FéDiária. Ative “Início automático” e, em “Economia de bateria”, escolha “Sem restrições”.</string>
  <string name="ajuda_fabricante_motorola">Motorola: Configurações › Apps › FéDiária › Bateria. Escolha “Sem restrições”.</string>
  <string name="ajuda_fabricante_outros">Outros aparelhos: procure nas configurações do app por “Bateria” e escolha a opção sem restrições. Se houver “Início automático”, ative-o.</string>
  <string name="ajuda_mais_detalhes">O site dontkillmyapp.com reúne instruções para cada fabricante (em inglês).</string>
  <string name="acao_abrir_notificacoes">Abrir configurações de notificação</string>
  <string name="acao_abrir_bateria">Abrir configurações de bateria</string>
  <string name="acao_abrir_site">Abrir dontkillmyapp.com</string>

